OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=20
OCR_DPI=200
EASYOCR_LANGUAGES=en
EASYOCR_GPU=false

TABLE_EXTRACTION_ENABLED=true
CONVERSATION_MEMORY_TURNS=6
